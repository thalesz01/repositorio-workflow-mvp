# Normaliza fim de linha no repositório (LF) e deixa o checkout nativo
# de cada sistema operacional. Evita diffs falsos de linha inteira.
* text=auto

# Arquivos que devem ser sempre CRLF (ferramentas Windows/VS)
*.sln    text eol=crlf
*.slnx   text eol=crlf
*.csproj text eol=crlf
*.props  text eol=crlf
*.targets text eol=crlf
*.cmd    text eol=crlf
*.bat    text eol=crlf

# Sempre LF
*.sh     text eol=lf

# Binários — nunca normalizar
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.dll binary
*.exe binary
*.snk binary
